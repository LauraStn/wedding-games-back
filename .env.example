# Copiez ce fichier en .env et adaptez les valeurs. Ne jamais commiter de vrai secret.

# --- Base de donnees PostgreSQL (utilise par compose.yaml et Spring) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wedding_games
DB_USER=wedding_games
DB_PASSWORD=change-me

# --- Serveur ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- CORS : origine(s) autorisee(s) du frontend, separees par des virgules ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Cookie de session opaque ---
APP_SESSION_COOKIE_NAME=wg_session
APP_SESSION_COOKIE_MAX_AGE_SECONDS=2592000
# false uniquement en dev local sans HTTPS ; toujours true en production
APP_SESSION_COOKIE_SECURE=false
APP_SESSION_COOKIE_SAME_SITE=Lax
APP_SESSION_COOKIE_DOMAIN=

# --- OpenAPI/Swagger : n'activer que sur les environnements autorises ---
SWAGGER_ENABLED=true

# --- Bootstrap du premier compte administrateur (dev/prod) ---
# Laissez APP_BOOTSTRAP_ADMIN_USERNAME vide pour desactiver le bootstrap (aucun compte ne sera cree).
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=change-me
APP_BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrateur

# --- Bootstrap du premier evenement (dev/prod) ---
# Laissez APP_BOOTSTRAP_EVENT_SLUG vide pour desactiver le bootstrap.
APP_BOOTSTRAP_EVENT_SLUG=notre-mariage
APP_BOOTSTRAP_EVENT_TITLE=Notre mariage
APP_BOOTSTRAP_EVENT_LANGUAGE=fr-FR

# --- URL de base du frontend pour construire les liens d'invitation ---
APP_INVITATION_BASE_URL=http://localhost:5173/invite
